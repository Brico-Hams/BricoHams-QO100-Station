#!/bin/sh
set -e

case "$1" in
  remove|upgrade|deconfigure)
    # Stopping the service releases the PTT holder and drops the carrier.
    systemctl stop bricohams-qo100.service >/dev/null 2>&1 || true
    ;;
esac
if [ "$1" = "remove" ]; then
  systemctl disable bricohams-qo100.service >/dev/null 2>&1 || true
fi

exit 0
