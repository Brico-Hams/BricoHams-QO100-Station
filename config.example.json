{
  "port": 8443,
  "host": "0.0.0.0",
  "tls": { "certPath": "./certs/server.crt", "keyPath": "./certs/server.key" },
  "publicUrl": "https://qo100.example.org:8443",
  "google": { "clientId": "YOUR-CLIENT-ID.apps.googleusercontent.com" },
  "allowlist": [
    { "email": "owner@example.org", "callsign": "EA4XXX", "role": "owner" },
    { "email": "operator@example.org", "callsign": "EA4YYY", "role": "operator" },
    { "email": "listener@example.org", "callsign": "EA4ZZZ", "role": "listener" }
  ],
  "tx": { "enabled": false, "totSeconds": 600, "heartbeatTimeoutMs": 2000, "armedTimeoutSeconds": 120 },
  "sdrangel": { "baseUrl": "http://127.0.0.1:8091" },
  "audio": {
    "enabled": true,
    "rxUdp": { "host": "127.0.0.1", "port": 9998 },
    "txUdp": { "host": "127.0.0.1", "port": 9999 },
    "spectrumUrl": "ws://127.0.0.1:8887"
  },
  "auditLogPath": "./data/audit.log",
  "stationDbPath": "./data/station.db",
  "recording": { "enabled": true, "dir": "./data/recordings", "maxFileMb": 100, "maxUserMb": 1000 },
  "iq": { "enabled": false, "maxUserMb": 2000, "maxSeconds": 600 },
  "cluster": { "enabled": false, "host": "dxcluster.example.org", "port": 7300, "callsign": "EA4XXX", "postSpots": false },
  "calendar": { "enabled": false, "url": "https://example.org/qo100-activities.ics", "refreshHours": 6, "maxKb": 256 },
  "webhooks": { "enabled": false, "endpoints": [{ "url": "https://example.org/hooks/bricohams", "events": ["decode", "spot", "qso_logged", "ptt_state"], "secretEnv": "BRICOHAMS_WEBHOOK_SECRET_1" }] },
  "plugins": { "enabled": [], "dir": "./plugins" }
}
